# Copy to .env in the install folder (next to presets.json) and edit.
# .env is git-ignored and survives reinstalls, so site-specific and personal
# settings belong here rather than in scripts/launch.cmd or the repository.
# Restart the controller after changing it.

# Shown as a "Need help?" box at the top of the help page. Leave blank to hide.
PEW_PTZ_CONTACT_NAME="First Last"
PEW_PTZ_CONTACT_EMAIL="you@example.com"
PEW_PTZ_CONTACT_PHONE="(555) 555-0100"

# Browser tab / home-screen name.
# PEW_PTZ_TITLE="Chapel PTZ"
